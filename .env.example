AGENT_APP_NAME=Begin Agent
AGENT_ENVIRONMENT=local
AGENT_LOG_LEVEL=INFO
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
AGENT_DATABASE_URL=postgresql+asyncpg://begin_agent:begin_agent@localhost:5432/begin_agent
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=120

AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_DEEPSEEK_MODEL=deepseek-flash

AGENT_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_GLM_MODEL=glm-5.3-flash

AGENT_MINIMAX_BASE_URL=https://api.minimax.io/v1
AGENT_MINIMAX_MODEL=MiniMax-M3.1-Flash

AGENT_KIMI_BASE_URL=https://api.moonshot.cn/v1
AGENT_KIMI_MODEL=kimi-k3

POSTGRES_DB=begin_agent
POSTGRES_USER=begin_agent
POSTGRES_PASSWORD=begin_agent


# 模型 API Key 通过模型配置页面录入并加密保存到数据库。
# 以下是服务器加密主密钥/管理令牌，不是供应商 API Key。
# 本机开发会自动生成 .data/model-credential.key；部署时持久挂载该文件或设置主密钥。
# AGENT_CREDENTIAL_ENCRYPTION_KEY=
AGENT_CREDENTIAL_KEY_FILE=.data/model-credential.key
# 默认使用内置账号；首次打开页面设置管理员密码（至少 12 位）。
AGENT_AUTH_MODE=password
# 仅本机开发可以显式选择 local 免登录；非本地环境禁止 local。
AGENT_MCP_ALLOWED_HOSTS=[]
# 独立 Worker 连接使用受控 BYPASSRLS 角色；API 角色必须 NOBYPASSRLS。
# AGENT_WORKER_DATABASE_URL=postgresql+asyncpg://worker:password@host/database
AGENT_WORKER_LEASE_SECONDS=60
AGENT_WORKER_POLL_SECONDS=1
# PMS 标准模板由启动脚本传入外部配置文件位置，不写死部署路径。
# AGENT_CONFIG_DIR=/absolute/platform/config
# 或 AGENT_CONFIG_FILE=/absolute/platform/config/application-test.yml
# 不设置应用日志/数据覆盖值时使用 PMS_LOG_DIR、PMS_SHARED_DIR/data。
# AGENT_LOG_DIR=
# AGENT_DATA_DIR=
