{
  "name": "begin-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run src --environment jsdom",
    "check:ui": "node --test scripts/ui-rules.test.mjs && node scripts/check-ui.mjs",
    "check": "npm test && npm run build",
    "build": "npm run check:ui && vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "~2.4.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
